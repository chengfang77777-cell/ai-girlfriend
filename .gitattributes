# 统一自动换行符处理（消除跨平台与 Windows CRLF/LF 警告）
* text=auto

# 跨平台源码与文本文件统一入库为 LF
*.dart text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf
*.py text eol=lf

# Windows 专用脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Linux/Shell 脚本必须使用 LF
*.sh text eol=lf

# 3D 资产与动画（必须声明 binary，禁止换行转换与文本 diff）
*.vrm binary
*.vrma binary
*.glb binary
*.gltf binary

# 媒体与图像资产
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary

# 字体资产
*.ttf binary
*.otf binary

# 二进制可执行与归档文件
*.apk binary
*.aab binary
*.jar binary
*.dll binary
*.exe binary
*.lib binary
*.so binary
